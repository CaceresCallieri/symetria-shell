#!/usr/bin/env bash
# Pre-commit hook: runs qmllint on staged .qml files and shellcheck on staged .sh files.
#
# Setup (once per clone):
#   git config core.hooksPath .githooks
#
# To bypass temporarily:
#   git commit --no-verify
#
# Note: this file has no .sh extension and is therefore not linted by the hook itself.
# To lint manually: shellcheck -e SC2329 .githooks/pre-commit

set -euo pipefail

# Collect staged files (excludes deleted files)
STAGED_QML=()
STAGED_SH=()
STAGED_FRAG=()

while IFS= read -r -d '' file; do
    case "$file" in
        *.qml) STAGED_QML+=("$file") ;;
        *.sh)  STAGED_SH+=("$file") ;;
        assets/shaders/*.frag) STAGED_FRAG+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=d -z)

# Nothing to lint
if [[ ${#STAGED_QML[@]} -eq 0 && ${#STAGED_SH[@]} -eq 0 && ${#STAGED_FRAG[@]} -eq 0 ]]; then
    exit 0
fi

FAILED=0

# --- qmllint ---
# Use the ABSOLUTE Qt6 path, never bare `qmllint`. On Arch, /usr/bin/qmllint
# belongs to qt5-declarative — Qt 5.15's tool, which reports version "1.0",
# predates Quickshell's pragmas, and exits 255 with NO output on ~93% of this
# repo. That binary winning the PATH lookup is what made both this hook and the
# CI job worthless for four months: the old guard below tested whether output
# was non-empty, so the Qt5 tool's silence read as "clean" locally, while in CI
# the shell's own "command not found" on stderr read as 408 code defects.
#
# Levels come from .qmllint.ini; findings parked at `info` there print without
# blocking the commit. Branch on the EXIT CODE, never on output emptiness.
#
# IMPORTANT: keep the "if ! output=$(cmd)" capture form. It prevents
# set -euo pipefail from aborting on qmllint's non-zero exit before the
# diagnostic is printed.
QMLLINT=/usr/lib/qt6/bin/qmllint
if [[ ${#STAGED_QML[@]} -gt 0 ]]; then
    if [[ -x "$QMLLINT" ]]; then
        # Regenerate the qs.* shadow tree so `import qs.config` resolves. Without
        # it the findings inflate roughly twelvefold and drown the real ones.
        # See scripts/gen-qmllint-tree.py.
        SHADOW_TREE="$(git rev-parse --show-toplevel)/build/qmllint"
        if ! "$(git rev-parse --show-toplevel)/scripts/gen-qmllint-tree.py" --quiet; then
            echo "pre-commit: failed to generate the qmllint module tree" >&2
            FAILED=1
        fi

        QML_ERRORS=0
        for file in "${STAGED_QML[@]}"; do
            if ! output=$("$QMLLINT" -I "$SHADOW_TREE" "$file" 2>&1); then
                echo "$output" >&2
                QML_ERRORS=$((QML_ERRORS + 1))
            fi
        done
        if [[ $QML_ERRORS -gt 0 ]]; then
            echo "qmllint: $QML_ERRORS file(s) failed" >&2
            FAILED=1
        fi
    else
        echo "pre-commit: $QMLLINT not found, skipping QML lint" >&2
        echo "pre-commit: install it with 'paru -S qt6-declarative' — do NOT substitute /usr/bin/qmllint (Qt5)" >&2
    fi
fi

# --- shellcheck ---
if [[ ${#STAGED_SH[@]} -gt 0 ]]; then
    if command -v shellcheck >/dev/null 2>&1; then
        SC_ERRORS=0
        for file in "${STAGED_SH[@]}"; do
            # -e SC2329: "function never invoked" false positive on dynamic dispatch
            if ! shellcheck -e SC2329 "$file"; then
                SC_ERRORS=$((SC_ERRORS + 1))
            fi
        done
        if [[ $SC_ERRORS -gt 0 ]]; then
            echo "shellcheck: $SC_ERRORS file(s) failed" >&2
            FAILED=1
        fi
    else
        echo "pre-commit: shellcheck not found, skipping shell lint" >&2
    fi
fi

# --- shader freshness ---
# The shell loads assets/shaders/*.frag.qsb, never the .frag. Committing a .frag
# without recompiling ships a silently stale shader — no error, no warning, just
# the wrong render. Recompile to a temp file and compare.
if [[ ${#STAGED_FRAG[@]} -gt 0 ]]; then
    QSB=/usr/lib/qt6/bin/qsb
    if [[ -x "$QSB" ]]; then
        for frag in "${STAGED_FRAG[@]}"; do
            qsb_path="${frag}.qsb"
            tmp=$(mktemp --suffix=.qsb)
            if ! "$QSB" --glsl "100es,120,150" --hlsl 50 --msl 12 -o "$tmp" "$frag" >/dev/null 2>&1; then
                echo "qsb: $frag failed to compile" >&2
                FAILED=1
            elif ! cmp -s "$tmp" "$qsb_path"; then
                echo "qsb: $qsb_path is stale — recompile and stage it:" >&2
                echo "  $QSB --glsl \"100es,120,150\" --hlsl 50 --msl 12 -o $qsb_path $frag" >&2
                FAILED=1
            fi
            rm -f "$tmp"
        done
    else
        echo "pre-commit: $QSB not found, skipping shader freshness check" >&2
    fi
fi

if [[ $FAILED -ne 0 ]]; then
    echo "" >&2
    echo "Pre-commit lint failed. Fix the issues above or use 'git commit --no-verify' to bypass." >&2
    exit 1
fi
