{
    "_comment_format": "Keys starting with '_' are ignored by the loader (not valid chord groups). Use them for inline documentation.",

    "screenshot": {
        "title": "Screenshot",
        "chords": [
            { "key": "f", "label": "Fullscreen", "command": "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png" },
            { "key": "s", "label": "Selection", "command": "grim -g \"$(slurp)\" ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png" },
            { "key": "w", "label": "Active Window", "command": "grim -g \"$(hyprctl activewindow -j | jq -r '.at[0],.at[1],.size[0],.size[1]' | tr '\\n' ' ' | awk '{printf \"%d,%d %dx%d\",$1,$2,$3,$4}')\" ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png" },
            { "key": "c", "label": "To Clipboard", "command": "grim -g \"$(slurp)\" - | wl-copy" }
        ]
    },
    "apps": {
        "title": "Launch App",
        "chords": [
            { "key": "t", "label": "Terminal", "command": "ghostty" },
            { "key": "b", "label": "Browser", "command": "firefox" },
            { "key": "f", "label": "File Manager", "command": "nautilus" },
            { "key": "e", "label": "Editor", "command": "neovide" }
        ]
    },

    "_comment_subgroups": "Chords can use 'group' instead of 'command' to navigate to another chord group (nested menus). If both are set, 'group' takes precedence.",

    "workspace-action": {
        "title": "Workspace Action",
        "chords": [
            { "key": "s", "label": "Switch workspace", "group": "switch-workspace" },
            { "key": "m", "label": "Move window", "group": "move-to-workspace" }
        ]
    },
    "switch-workspace": {
        "title": "Switch →",
        "chords": [
            { "key": "1", "label": "Workspace 1", "command": "hyprctl dispatch workspace 1" },
            { "key": "2", "label": "Workspace 2", "command": "hyprctl dispatch workspace 2" }
        ]
    },
    "move-to-workspace": {
        "title": "Move Window →",
        "chords": [
            { "key": "1", "label": "Workspace 1", "command": "hyprctl dispatch movetoworkspacesilent 1" },
            { "key": "2", "label": "Workspace 2", "command": "hyprctl dispatch movetoworkspacesilent 2" }
        ]
    },

    "_comment_expand": "DRY: define a workspace set ONCE in the top-level '_workspaces' array, then let any number of menus generate their chords from it instead of repeating the list. A menu opts in with an 'expand' object (in place of 'chords'). For each '_workspaces' entry, a chord is built from the menu's 'command' template with '{ws}' replaced by the entry's 'ws' and '{special}' by its 'special'. Entries that carry a 'special' field are special workspaces; if the menu defines 'specialCommand', that template is used for them instead (e.g. a switch menu toggles them rather than dispatching 'workspace'). '_workspaces' is consumed by the expander and never shown as its own menu.",
    "_workspaces": [
        { "key": "1", "label": "Workspace 1", "ws": "1" },
        { "key": "S", "label": "symmetria", "ws": "name:symmetria" },
        { "key": "C", "label": "communications", "ws": "special:communications", "special": "communications" },
        { "key": "Q", "label": "special", "ws": "special", "special": "" }
    ],
    "switch-all-workspaces": {
        "title": "Switch Workspace",
        "expand": {
            "command": "hyprctl dispatch workspace {ws}",
            "specialCommand": "hyprctl dispatch togglespecialworkspace {special}"
        }
    },
    "move-to-all-workspaces": {
        "title": "Send Window →",
        "expand": {
            "command": "hyprctl dispatch movetoworkspacesilent {ws}"
        }
    }
}
