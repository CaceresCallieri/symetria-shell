pragma ComponentBehavior: Bound

import qs.components
import qs.components.effects
import qs.services
import qs.config
import qs.utils
import Quickshell.Services.SystemTray
import QtQuick

MouseArea {
    id: root

    required property SystemTrayItem modelData

    acceptedButtons: Qt.LeftButton | Qt.RightButton
    hoverEnabled: true
    cursorShape: Qt.PointingHandCursor
    // A `glyph` substitution (bar.tray.iconSubs) draws the app as a shell glyph
    // while the active glyph family covers it — a hairline mark beside the
    // status glyphs instead of a filled pixmap. Otherwise the app's own icon.
    readonly property string glyph: Icons.traySubFor(modelData.id, modelData.title)?.glyph ?? ""
    readonly property bool drawsGlyph: glyph !== "" && Glyphs.covers(glyph)

    implicitWidth: Config.bar.sizes.iconSize
    implicitHeight: Config.bar.sizes.iconSize

    onClicked: event => {
        if (event.button === Qt.LeftButton)
            modelData.activate();
        else
            modelData.secondaryActivate();
    }

    ColouredIcon {
        id: icon

        anchors.fill: parent
        visible: !root.drawsGlyph
        source: root.drawsGlyph ? "" : Icons.getTrayIcon(root.modelData.id, root.modelData.title, root.modelData.icon)
        // m3tertiary matches PillContainer's foreground — a recoloured tray icon
        // sits inline with the status glyphs, so a separate tone reads as a
        // mismatch rather than a rank. Rationale on PillContainer.colour.
        colour: Colours.palette.m3tertiary
        // A DESIGN CHOICE, not a per-app workaround: the shell's surface material
        // is machined metal and the bar carries exactly one chromatic accent (the
        // power glyph), so tray icons are flattened to the palette foreground on
        // purpose. The cost is real and deliberate — Colouriser runs colorization
        // at full strength, so brand colour and any colour-coded state an app
        // encodes in its icon are lost for every tray item, not just misbehaving
        // ones.
        //
        // Turning this off is a supported choice; it is not a fix. With it off,
        // the raw app pixmap is drawn untouched and nothing constrains its
        // brightness: LocalSend advertises a literal `logo-32-white.png` and
        // lands at L≈99%, brighter than any colour in the palette. Its SNI id is
        // autogenerated per session, so an `id` substitution cannot reach it; a
        // bar.tray.iconSubs entry keyed on its stable `title` can (traySubFor).
        layer.enabled: Config.bar.tray.recolour
    }

    MaterialIcon {
        anchors.centerIn: parent
        visible: root.drawsGlyph
        text: root.glyph
        // The status pill's tone, so the two pills read as one row of glyphs.
        color: Qt.alpha(Colours.palette.m3tertiary, Appearance.emphasis.status)
    }
}
